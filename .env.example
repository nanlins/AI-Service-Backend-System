# 复制为 .env 后按需修改；docker compose 会自动读取本文件做变量替换
APP_ENV=dev
DEBUG=true

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:dev_pg_pw_001@localhost:5435/ai_backend
POSTGRES_PASSWORD=dev_pg_pw_001

# Redis
REDIS_URL=redis://localhost:6381/0

# RabbitMQ
RABBITMQ_URL=amqp://admin:dev_mq_pw_001@localhost:5672/
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=dev_mq_pw_001

# JWT
JWT_SECRET=dev_jwt_secret_001
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM：mock（默认，无需密钥）或 openai（OpenAI 兼容供应商）
LLM_PROVIDER=mock
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

# 启动时自动执行 alembic upgrade head（docker compose 内由 migrate 服务负责，建议 false）
AUTO_MIGRATE=false
